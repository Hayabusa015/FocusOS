{
  "name": "cortex",
  "productName": "Cortex",
  "version": "0.1.1",
  "description": "A personal focus app and second brain, with Atlas, a voice assistant.",
  "author": "Matthew Shull",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.16",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "marked": "18.0.14",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.21.0",
  "allowScripts": {
    "electron-winstaller": false,
    "esbuild": false
  }
}
